# ── AWS (Strands SDK + Bedrock + DynamoDB) ──────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock model for Strands Planner agent
# Check availability first: aws bedrock list-foundation-models --region
# <region> --query "modelSummaries[?providerName=='Anthropic']" — Bedrock's
# Anthropic catalog changes over time and older dated model ids get retired.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Groq (LLM reasoning/explanation layer) ───────────────────────────────────
GROQ_API_KEY=your_groq_key
LLM_MODEL=llama-3.3-70b-versatile

# ── GitHub write-back (optional) ─────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
WRITEBACK_ENABLED=false

# ── Memory backend ───────────────────────────────────────────────────────────
# local = file-backed (default, zero setup)
# dynamodb = AWS DynamoDB
MEMORY_BACKEND=local
MEMORY_LOCAL_PATH=data/nexus_incidents.json
DYNAMODB_TABLE=nexus-incidents

# ── Thresholds ────────────────────────────────────────────────────────────────
AUTO_EXECUTE_ENABLED=true
AUTO_EXECUTE_MIN_CONFIDENCE=0.75

# ── Demo mode (no live DataHub needed) ───────────────────────────────────────
USE_MOCK_DATAHUB=true
ENV=development
